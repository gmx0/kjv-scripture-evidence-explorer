{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kjv-evidence.local/schemas/corpus-manifest-1.0.0.json",
  "title": "KJV Scripture Evidence Explorer corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "corpusVersion", "edition", "sourceUrl", "sourceMember", "retrievedAt",
    "sourceSha256", "memberSha256", "canonicalSha256", "importerVersion", "encoding",
    "lineEndings", "canonicalFormat", "bookOrder", "counts", "license"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "edition": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sourceMember": { "const": "TEXT-PCE.txt" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "memberSha256": { "$ref": "#/$defs/sha256" },
    "canonicalSha256": { "$ref": "#/$defs/sha256" },
    "importerVersion": { "type": "string", "minLength": 1 },
    "encoding": { "const": "windows-1252" },
    "lineEndings": { "const": "CRLF" },
    "canonicalFormat": { "const": "jsonl-utf8-lf-v1" },
    "bookOrder": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["books", "chapters", "verses", "italicSpans", "paratextItems"],
      "properties": {
        "books": { "const": 66 },
        "chapters": { "type": "integer", "minimum": 1 },
        "verses": { "type": "integer", "minimum": 1 },
        "italicSpans": { "type": "integer", "minimum": 0 },
        "paratextItems": { "type": "integer", "minimum": 0 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "jurisdictionNotes"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "jurisdictionNotes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
